---
import Layout from '../layouts/Layout.astro';
import HistoryCard from '../components/HistoryCard.astro';
---

<Layout>
	<div style="display: none;"><HistoryCard /></div>
	<div class="app-wrapper">
		<!-- Botón del Menú -->
		<button id="menu-btn" class="menu-btn" aria-label="Abrir menú">
			<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
		</button>

		<!-- Sidebar (Menú Lateral) -->
		<div id="sidebar-overlay" class="sidebar-overlay"></div>
		<aside id="sidebar" class="sidebar">
			<div class="sidebar-header">
				<h2>Cartas Anteriores</h2>
				<button id="close-btn" class="close-btn" aria-label="Cerrar menú">
					<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			<div class="sidebar-content">
				<div id="history-list" class="history-list">
					<div class="loading-text">Cargando cartas...</div>
				</div>
			</div>
		</aside>

		<!-- Contenido Principal -->
		<main class="main-container">
			<div class="letter-wrapper">
				<div id="letter-card-container" class="letter-card-container">
					<div id="letter-card-inner" class="letter-card-inner">
						
						<!-- Frente de la carta (Sobre cerrado) -->
						<div class="letter-face letter-front">
							<div class="letter-date-display"></div>
							<div class="envelope-design">
								<div class="envelope-flap"></div>
								<div class="envelope-seal">❤️</div>
							</div>
							<h3 class="front-text">Una carta para ti</h3>
							<p class="tap-hint">Toca para abrir</p>
						</div>

						<!-- Reverso de la carta (Mensaje) -->
						<div class="letter-face letter-back">
							<div class="letter-date-display"></div>
							<div class="letter-inner" id="letter-content-container">
								<div class="loader">
									<div class="heart"></div>
								</div>
								<p class="loading-msg">Buscando tu carta...</p>
							</div>
						</div>

					</div>
				</div>
			</div>
		</main>
	</div>
</Layout>

<style>
	:root {
		/* Paleta de colores */
		--bg-gradient: linear-gradient(135deg, #3c1053 0%, #15002b 100%);
		--letter-bg: linear-gradient(145deg, #fdf7e3 0%, #f4e4bc 100%);
		--text-color: #3e2723;
		--gold-accent: #d4af37;
		--menu-bg: rgba(60, 16, 83, 0.95);
	}

	.app-wrapper {
		width: 100%;
		height: 100%;
		min-height: 100vh;
		background: var(--bg-gradient);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	/* Animación de destellos en el fondo */
	.app-wrapper::before {
		content: "";
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.1) 0%, transparent 60%);
		pointer-events: none;
		z-index: 0;
	}

	/* Botón transparente del menú superior izquierdo */
	.menu-btn {
		position: absolute;
		top: 20px;
		left: 20px;
		z-index: 10;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255,255,255,0.2);
		color: rgba(255,255,255,0.9);
		border-radius: 50%;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.3s ease;
		box-shadow: 0 4px 15px rgba(0,0,0,0.2);
		-webkit-tap-highlight-color: transparent;
	}

	.menu-btn:active {
		transform: scale(0.9);
		background: rgba(255, 255, 255, 0.2);
	}

	/* Menú Lateral (Sidebar) */
	.sidebar-overlay {
		position: fixed;
		top: 0; left: 0; right: 0; bottom: 0;
		background: rgba(0,0,0,0.5);
		backdrop-filter: blur(4px);
		z-index: 40;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.sidebar-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}

	.sidebar {
		position: fixed;
		top: 0;
		left: -100%;
		width: 85%; /* Optimizada para teléfono */
		max-width: 340px;
		height: 100%;
		background: rgba(30, 8, 45, 0.85); /* Fondo más oscuro y translúcido */
		backdrop-filter: blur(15px);
		-webkit-backdrop-filter: blur(15px);
		z-index: 50;
		box-shadow: 5px 0 25px rgba(0,0,0,0.6);
		transition: left 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		display: flex;
		flex-direction: column;
		border-right: 1px solid rgba(255,255,255,0.1);
	}

	.sidebar.active {
		left: 0;
	}

	.sidebar-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px;
		border-bottom: 1px solid rgba(255,255,255,0.1);
	}

	.sidebar-header h2 {
		color: white;
		font-family: 'Playfair Display', serif;
		font-size: 1.2rem;
		font-weight: 600;
	}

	.close-btn {
		background: none;
		border: none;
		color: white;
		cursor: pointer;
		padding: 5px;
		-webkit-tap-highlight-color: transparent;
	}

	.sidebar-content {
		flex: 1;
		overflow-y: auto;
		padding: 20px;
	}

	.history-list {
		display: flex;
		flex-direction: column;
		gap: 0; /* El espaciado lo maneja el margin-bottom de la card */
	}

	.loading-text {
		color: #ffffff !important;
		font-family: 'Playfair Display', serif;
		font-size: 1.1rem;
		opacity: 0.85;
		text-align: center;
		padding: 30px 20px;
	}

	/* Contenedor Principal (Carta) */
	.main-container {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px 20px;
		z-index: 1;
	}

	.letter-wrapper {
		width: 90%; /* Ajuste de ancho para teléfonos */
		max-width: 350px; /* Perfecto para iPhone SE y similares */
		perspective: 1500px;
	}

	.letter-card-container {
		width: 100%;
		height: 55vh;
		min-height: 400px;
		max-height: 600px;
		position: relative;
		animation: float 6s ease-in-out infinite;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	/* Contenedor interno que maneja el efecto 3D */
	.letter-card-inner {
		width: 100%;
		height: 100%;
		position: relative;
		transition: transform 0.8s cubic-bezier(0.4, 0.2, 0.2, 1); /* Transición suave de giro */
		transform-style: preserve-3d;
	}

	.letter-card-inner.flipped {
		transform: rotateY(180deg);
	}

	/* Estilos comunes de las caras (Frente y Reverso) */
	.letter-face {
		position: absolute;
		width: 100%;
		height: 100%;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		border-radius: 12px;
		box-shadow: 
			0 15px 40px rgba(0,0,0,0.6),
			inset 0 0 0 1px rgba(255,255,255,0.6),
			inset 0 0 20px rgba(212, 175, 55, 0.15);
		background: var(--letter-bg);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 35px 25px;
	}

	.letter-front {
		transform: rotateY(0deg);
	}

	.letter-back {
		transform: rotateY(180deg);
		overflow-y: auto;
	}

	/* Esquinas decorativas para ambas caras */
	.letter-face::before, .letter-face::after {
		content: "";
		position: absolute;
		width: 30px;
		height: 30px;
		border: 2px solid var(--gold-accent);
		opacity: 0.6;
		pointer-events: none;
	}

	.letter-face::before {
		top: 15px; left: 15px;
		border-right: none; border-bottom: none;
	}

	.letter-face::after {
		bottom: 15px; right: 15px;
		border-left: none; border-top: none;
	}

	/* Diseño de sobre en el frente */
	.envelope-design {
		position: relative;
		width: 120px;
		height: 80px;
		border: 2px solid var(--gold-accent);
		border-radius: 6px;
		margin-bottom: 25px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255,255,255,0.3);
		opacity: 0.8;
	}

	.envelope-flap {
		position: absolute;
		top: -40.5px;
		left: 15.5px;
		width: 85px;
		height: 85px;
		border-bottom: 2px solid var(--gold-accent);
		border-right: 2px solid var(--gold-accent);
		transform: scaleY(0.7) rotate(45deg);
		border-radius: 0 0 8px 0;
	}

	.envelope-seal {
		font-size: 26px;
		z-index: 2;
		background: var(--letter-bg);
		border-radius: 50%;
		padding: 4px;
		box-shadow: 0 2px 5px rgba(0,0,0,0.1);
	}

	.front-text {
		font-family: 'Playfair Display', serif;
		color: var(--text-color);
		font-size: 1.6rem;
		margin-bottom: 8px;
		text-align: center;
	}
	
	.tap-hint {
		font-size: 0.95rem;
		opacity: 0.6;
		color: var(--text-color);
		animation: pulse 2s infinite;
	}

	.letter-inner {
		width: 100%;
		text-align: center;
		color: var(--text-color);
	}

	.letter-text {
		font-family: 'Playfair Display', serif;
		font-size: 1.25rem; /* Ligeramente más pequeño para el ancho móvil */
		line-height: 1.6;
		white-space: pre-wrap;
		text-align: center;
		margin-bottom: 20px;
	}

	.letter-date-display {
		position: absolute;
		top: 15px;
		right: 15px;
		font-family: 'Playfair Display', serif;
		font-size: 0.9rem;
		color: var(--gold-accent);
		font-weight: 600;
		text-transform: capitalize;
	}

	/* Animación de carga (Corazón palpitante) */
	.loader {
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 20px;
	}

	.heart {
		background-color: #e91e63;
		width: 30px;
		height: 30px;
		position: relative;
		transform: rotate(-45deg);
		animation: heartbeat 1.2s infinite;
	}

	.heart::before,
	.heart::after {
		content: "";
		background-color: #e91e63;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		position: absolute;
	}

	.heart::before {
		top: -15px; left: 0;
	}
	.heart::after {
		left: 15px; top: 0;
	}

	.loading-msg {
		font-family: 'Playfair Display', serif;
		color: var(--text-color);
		opacity: 0.8;
		font-size: 1.1rem;
	}

	/* Estado cuando no hay carta */
	.empty-state {
		text-align: center;
		color: var(--text-color);
	}
	
	.empty-state h3 {
		font-family: 'Playfair Display', serif;
		font-size: 1.6rem;
		margin-bottom: 12px;
		color: #d4af37;
	}

	/* Animaciones clave */
	@keyframes float {
		0%, 100% { transform: translateY(0) rotateX(2deg) rotateY(-1deg); }
		50% { transform: translateY(-12px) rotateX(-2deg) rotateY(1deg); }
	}

	@keyframes pulse {
		0%, 100% { opacity: 0.4; transform: scale(1); }
		50% { opacity: 0.8; transform: scale(1.05); }
	}

	@keyframes heartbeat {
		0% { transform: scale(0.8) rotate(-45deg); }
		5% { transform: scale(0.9) rotate(-45deg); }
		10% { transform: scale(0.8) rotate(-45deg); }
		15% { transform: scale(1) rotate(-45deg); }
		50% { transform: scale(0.8) rotate(-45deg); }
		100% { transform: scale(0.8) rotate(-45deg); }
	}

	/* Estilos para corazones flotantes dinámicos creados con JS */
	:global(.tap-heart) {
		position: fixed;
		pointer-events: none;
		color: #e91e63;
		font-size: 28px;
		animation: floatUp 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
		z-index: 100;
		text-shadow: 0 0 10px rgba(233, 30, 99, 0.4);
	}

	@keyframes floatUp {
		0% { transform: translateY(0) scale(0.5) rotate(0deg); opacity: 1; }
		100% { transform: translateY(-180px) scale(1.8) rotate(25deg); opacity: 0; }
	}
</style>

<script>
	// Configuración de la API
	const API_BASE = '/api';
	
	// Referencias a los elementos del DOM
	const menuBtn = document.getElementById('menu-btn');
	const closeBtn = document.getElementById('close-btn');
	const sidebar = document.getElementById('sidebar');
	const overlay = document.getElementById('sidebar-overlay');
	const historyList = document.getElementById('history-list');
	const letterContainer = document.getElementById('letter-content-container');
	const cardContainer = document.getElementById('letter-card-container');
	const cardInner = document.getElementById('letter-card-inner');

	// Estado local
	let letters = [];
	let currentDisplayedDate = '';
	let isFlipped = false;

	// Utilidades de Fechas
	const formatDateToAPI = (date) => {
		const d = new Date(date);
		return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
	};

	const formatDisplayDate = (dateString) => {
		// Extraer la parte de la fecha (YYYY-MM-DD) e ignorar la hora y zona horaria
		const parts = dateString.split('T')[0].split('-');
		if (parts.length >= 3) {
			return `${parts[2]}/${parts[1]}/${parts[0]}`;
		}
		return dateString;
	};

	const getTodayString = () => {
		return formatDateToAPI(new Date());
	};

	// Manejo del Menú
	const toggleMenu = () => {
		sidebar.classList.toggle('active');
		overlay.classList.toggle('active');
	};

	menuBtn.addEventListener('click', toggleMenu);
	closeBtn.addEventListener('click', toggleMenu);
	overlay.addEventListener('click', toggleMenu);

	// Peticiones a la API
	const fetchHistory = async () => {
		try {
			const res = await fetch(`${API_BASE}/letters`);
			if (res.ok) {
				const data = await res.json();
				letters = data || [];
				renderHistory();
			}
		} catch (error) {
			console.error('Error fetching history:', error);
			historyList.innerHTML = '<li class="loading-text">Error al cargar historial.</li>';
		}
	};

	const fetchLetter = async (dateStr, autoOpen = false) => {
		// Resetear estado de la carta al cambiar de fecha
		isFlipped = autoOpen;
		if (autoOpen) {
			cardInner.classList.add('flipped');
		} else {
			cardInner.classList.remove('flipped');
		}
		
		currentDisplayedDate = dateStr;

		// Actualizar la fecha siempre en la esquina superior derecha
		document.querySelectorAll('.letter-date-display').forEach(el => {
			el.textContent = formatDisplayDate(dateStr);
		});

		// 1. Buscar primero en la memoria si ya descargamos esta carta en el historial
		const searchDatePart = dateStr.split('T')[0];
		const cachedLetter = letters.find(l => {
			if (!l.show_date) return false;
			return l.show_date.split('T')[0] === searchDatePart;
		});

		if (cachedLetter) {
			renderLetter(cachedLetter);
			return; // 100% seguro, se carga al instante sin petición
		}

		// 2. Si no está en memoria, hacer la petición
		renderLoader();
		try {
			const res = await fetch(`${API_BASE}/letters/date?date=${dateStr}`);
			if (res.ok) {
				const data = await res.json();
				renderLetter(data);
			} else if (res.status === 404) {
				renderNoLetter(dateStr);
			} else {
				throw new Error('Server error');
			}
		} catch (error) {
			console.error('Error fetching letter:', error);
			renderError();
		}
	};

	// Interacción (Tap en la carta para girar)
	const handleTap = async (e) => {
		if (!currentDisplayedDate) return;
		
		// Lógica de Giro
		if (!isFlipped) {
			isFlipped = true;
			cardInner.classList.add('flipped');

			// Crear varios corazones al abrir
			for(let i = 0; i < 4; i++) {
				setTimeout(() => {
					createHeart(e);
				}, i * 150);
			}

			// Llamada a la API para incrementar contador en el primer "tap" / "open"
			try {
				fetch(`${API_BASE}/letters/tap?date=${currentDisplayedDate}`, {
					method: 'POST'
				}).catch(err => console.error('Tap request error:', err));
			} catch (err) {}

		} else {
			// Si ya está volteada, tocarla suelta corazones igualmente
			createHeart(e);
		}
	};

	const createHeart = (e) => {
		const heart = document.createElement('div');
		heart.innerHTML = '❤️';
		heart.className = 'tap-heart';
		
		let x = window.innerWidth / 2;
		let y = window.innerHeight / 2;
		
		if (e && e.clientX) {
			x = e.clientX;
			y = e.clientY;
		} else if (e && e.touches && e.touches.length > 0) {
			x = e.touches[0].clientX;
			y = e.touches[0].clientY;
		}
		
		// Pequeña dispersión aleatoria
		const offsetX = (Math.random() - 0.5) * 60;
		const offsetY = (Math.random() - 0.5) * 40;
		
		heart.style.left = `${x - 14 + offsetX}px`;
		heart.style.top = `${y - 14 + offsetY}px`;
		document.body.appendChild(heart);
		
		setTimeout(() => {
			heart.remove();
		}, 1400);
	};

	cardContainer.addEventListener('click', handleTap);
	cardContainer.addEventListener('touchstart', handleTap, { passive: true });

	// Funciones de Renderizado
	const renderLoader = () => {
		letterContainer.innerHTML = `
			<div class="loader">
				<div class="heart"></div>
			</div>
			<p class="loading-msg">Buscando tu carta...</p>
		`;
	};

	const renderLetter = (letter) => {
		letterContainer.innerHTML = `
			<div class="letter-text">${letter.content}</div>
		`;
	};

	const renderNoLetter = (dateStr) => {
		const isToday = dateStr === getTodayString();
		letterContainer.innerHTML = `
			<div class="empty-state">
				<h3>${isToday ? 'Aún no hay carta' : 'Sin carta'}</h3>
				<p>${isToday ? 'Parece que tu carta de hoy todavía no ha llegado. ¡Vuelve más tardecito!' : 'No se encontró ninguna carta de amor para esta fecha.'}</p>
			</div>
		`;
	};

	const renderError = () => {
		letterContainer.innerHTML = `
			<div class="empty-state">
				<h3>Lo sentimos</h3>
				<p>Ocurrió un pequeño problema al intentar leer tu carta. Por favor, intenta de nuevo.</p>
			</div>
		`;
	};

	const renderHistory = () => {
		if (!letters || letters.length === 0) {
			historyList.innerHTML = '<div class="loading-text">No hay cartas previas.</div>';
			return;
		}

		const today = getTodayString();
		const pastLetters = letters.filter(l => l.show_date < today);
		pastLetters.sort((a, b) => b.show_date.localeCompare(a.show_date));

		if (pastLetters.length === 0) {
			historyList.innerHTML = '<div class="loading-text">Aún no hay cartas pasadas.</div>';
			return;
		}

		historyList.innerHTML = '';
		pastLetters.forEach(letter => {
			const isUnread = !letter.opened_count || letter.opened_count === 0;

			// Usar el nuevo Custom Element que hemos creado
			const card = document.createElement('history-card');
			card.setAttribute('date', formatDisplayDate(letter.show_date));
			card.setAttribute('preview', letter.content);
			card.setAttribute('unread', isUnread ? 'true' : 'false');
			
			card.addEventListener('card-click', () => {
				fetchLetter(letter.show_date, true); // autoOpen en true, mueve a carta abierta
				toggleMenu(); // Cerrar menú
				
				if (isUnread) {
					letter.opened_count = 1; // optimistically mark as read
					// El componente visual borra su indicador automáticamente
					
					// Registrar el tap en la API
					try {
						fetch(`${API_BASE}/letters/tap?date=${letter.show_date}`, { method: 'POST' });
					} catch(e) {}
				}
			});
			
			historyList.appendChild(card);
		});
	};

	// Inicialización
	const init = () => {
		fetchHistory();
		fetchLetter(getTodayString());
	};

	init();
</script>
